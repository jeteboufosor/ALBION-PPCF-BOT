# Discord
DISCORD_TOKEN=replace_me
GUILD_ID=123456789012345678

# Albion Online
ALBION_GUILD_ID=replace_me
ALBION_GUILD_NAME=replace_me
ALBION_API_BASE_URL=https://gameinfo.albiononline.com/api/gameinfo
ALBION_MARKET_BASE_URL=https://www.albion-online-data.com/api/v2/stats
ALBION_TOOLS_BASE_URL=https://albion.tools

# Base de données
# Local: laissez vide pour utiliser SQLite ./data/albion_guild_bot.db
# Railway: fourni automatiquement, ex: postgresql://user:pass@host:port/db
DATABASE_URL=
SQLITE_PATH=./data/albion_guild_bot.db

# Bot
COMMAND_PREFIX=!
LOG_LEVEL=INFO
SYNC_COMMANDS_ON_START=true
DEFAULT_TIMEZONE=UTC

# Salons / rôles: le bot privilégie les IDs si renseignés, sinon les noms configurés dans bot/config.py
ALERTS_CHANNEL_ID=
BACKUP_CHANNEL_ID=
